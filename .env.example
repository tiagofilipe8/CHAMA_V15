# =====================================================================
# Configuracao do sistema ordens de servico (OS)
# Copie este arquivo para ".env" e preencha com seus valores.
# =====================================================================

# --- Servidor ---
PORT=7070
NODE_ENV=production

# --- Banco de dados (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=os_service
DB_USER=os_app
DB_PASSWORD=os_app_secret

# --- Autenticacao JWT ---
# Troque por um valor aleatorio em producao: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_este_secret_por_um_valor_aleatorio_longo
JWT_EXPIRES_IN=8h

# --- URL publica (para links em emails/whatsapp) ---
PUBLIC_URL=http://localhost:7070

# --- E-mail (SMTP) para notificacoes ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="Central de Atendimento"
MAIL_FROM_EMAIL=no-reply@exemplo.com.br

# --- WhatsApp Cloud API (Meta) ---
# Oficial: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VERSION=v21.0